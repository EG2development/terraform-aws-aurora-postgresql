# The smallest useful call: an Aurora Serverless v2 cluster with one instance
# in two private subnets you already have, master password generated by RDS and
# kept in Secrets Manager. Examples call the module from the working copy so CI
# validates this repository's code; a real caller pins a Git source
# (README.md, "Usage").

provider "aws" {
  region = var.region
}

module "aurora" {
  source = "../.."

  name           = var.name
  engine_version = var.engine_version
  vpc_id         = var.vpc_id
  subnet_ids     = var.subnet_ids
}
