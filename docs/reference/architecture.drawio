        <mxCell id="c2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#232F3E;" value="terraform-aws-aurora-postgresql — architecture" vertex="1">
          <mxGeometry height="30" width="1300" x="40" y="20" as="geometry" />
