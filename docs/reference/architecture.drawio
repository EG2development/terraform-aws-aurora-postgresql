        <mxCell id="c3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#545B64;spacing=4;fontSize=12;" value="An encrypted Aurora PostgreSQL cluster, Serverless v2 by default, with deletion protection, a final snapshot, IAM authentication and an RDS-managed master password." vertex="1">
          <mxGeometry height="40" width="1354" x="40" y="50" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" value="&lt;b&gt;Inputs&lt;/b&gt;&lt;br&gt;&lt;b&gt;name&lt;/b&gt; — required&lt;br&gt;&lt;b&gt;engine_version&lt;/b&gt; — required&lt;br&gt;&lt;b&gt;vpc_id&lt;/b&gt; — required&lt;br&gt;&lt;b&gt;subnet_ids&lt;/b&gt; — required&lt;br&gt;db_subnet_group_name = null&lt;br&gt;allowed_security_group_ids = {}&lt;br&gt;port = 5432&lt;br&gt;database_name = null&lt;br&gt;master_username = &quot;postgres&quot;&lt;br&gt;manage_master_user_password = true&lt;br&gt;master_password = null (sensitive)&lt;br&gt;master_user_secret_kms_key_arn = null&lt;br&gt;kms_key_arn = null&lt;br&gt;iam_database_authentication_enabled = true&lt;br&gt;instance_class = &quot;db.serverless&quot;&lt;br&gt;instance_count = 1&lt;br&gt;serverlessv2_min_capacity = 0.5&lt;br&gt;serverlessv2_max_capacity = 16&lt;br&gt;deletion_protection = true&lt;br&gt;skip_final_snapshot = false&lt;br&gt;backup_retention_period = 7&lt;br&gt;preferred_backup_window = null&lt;br&gt;preferred_maintenance_window = null&lt;br&gt;enabled_cloudwatch_logs_exports = [&quot;postgresql&quot;]&lt;br&gt;monitoring_interval = 60&lt;br&gt;performance_insights_enabled = true&lt;br&gt;auto_minor_version_upgrade = true&lt;br&gt;allow_major_version_upgrade = false&lt;br&gt;apply_immediately = null&lt;br&gt;tags = {}" vertex="1">
          <mxGeometry height="470" width="280" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EEF6E8;strokeColor=#7AA116;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" value="&lt;b&gt;Outputs&lt;/b&gt;&lt;br&gt;cluster_identifier&lt;br&gt;cluster_arn&lt;br&gt;cluster_resource_id&lt;br&gt;cluster_endpoint&lt;br&gt;cluster_reader_endpoint&lt;br&gt;cluster_port&lt;br&gt;database_name&lt;br&gt;master_username&lt;br&gt;master_user_secret_arn&lt;br&gt;security_group_id&lt;br&gt;db_subnet_group_name&lt;br&gt;instance_identifiers" vertex="1">
