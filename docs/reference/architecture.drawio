        <mxCell id="c6" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDF2F4;strokeColor=#DD344C;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" value="&lt;b&gt;IAM the module creates&lt;/b&gt;&lt;br&gt;aws_iam_role.rds_monitoring, when monitoring_interval &gt; 0 — trusted by monitoring.rds.amazonaws.com only when aws:SourceAccount is the caller&#39;s and aws:SourceArn matches arn:{partition}:rds:{region}:{account}:db:*; managed policy AmazonRDSEnhancedMonitoringRole (CloudWatch Logs on groups whose names start with RDS).&lt;br&gt;No database access: no users, no rds-db:connect, no access to the master secret." vertex="1">
          <mxGeometry height="161" width="294" x="1320" y="316" as="geometry" />
        </mxCell>
